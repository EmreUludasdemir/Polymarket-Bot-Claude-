# =============================================================================
# POLYMARKET TRADING BOT - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# =============================================================================

# === WALLET CONFIGURATION ===
# Your Ethereum private key (with or without 0x prefix)
# SECURITY WARNING: Keep this secret! Never share or commit!
PRIVATE_KEY=your_private_key_here

# Your Polymarket profile/proxy wallet address
# Find this in your Polymarket profile settings
PROXY_WALLET_ADDRESS=your_polymarket_profile_address

# Signature Type determines how orders are signed:
# 0 = EOA/MetaMask (direct wallet)
# 1 = Email/Magic (Polymarket email login) - MOST COMMON
# 2 = Browser Proxy Wallet
SIGNATURE_TYPE=1

# === POLYMARKET API ENDPOINTS ===
# Main CLOB (Central Limit Order Book) API
CLOB_API_URL=https://clob.polymarket.com

# Gamma API for market data
GAMMA_API_URL=https://gamma-api.polymarket.com

# WebSocket for real-time data
WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# === POLYGON NETWORK ===
# Polygon mainnet RPC URL (use your own for production!)
POLYGON_RPC_URL=https://polygon-rpc.com

# Chain ID (137 = Polygon Mainnet)
CHAIN_ID=137

# === TRADING PARAMETERS ===
# Starting capital in USDC (adjust based on your funds)
INITIAL_CAPITAL=500

# Per-trade risk percentage (0.02 = 2%)
# For $500: 2% = $10 max risk per trade
RISK_PER_TRADE=0.02

# Maximum daily loss percentage before stopping (0.05 = 5%)
# For $500: 5% = $25 max daily loss
MAX_DAILY_LOSS=0.05

# Maximum total drawdown from peak (0.20 = 20%)
# For $500: 20% = $100 max drawdown
MAX_DRAWDOWN=0.20

# Minimum edge required to enter a trade (0.03 = 3%)
MIN_EDGE_THRESHOLD=0.03

# === STRATEGY SETTINGS ===
# Fixed trade unit size in USDC
# Recommended: $3-5 for $500 capital
TRADE_UNIT=3.0

# Kelly fraction (0.25 = quarter Kelly, conservative)
# Full Kelly is too aggressive; 0.25 is standard for trading
KELLY_FRACTION=0.25

# Arbitrage minimum spread percentage (0.005 = 0.5%)
# Must cover gas costs to be profitable
ARB_MIN_SPREAD=0.005

# === MARKET MAKING SETTINGS (PRIMARY STRATEGY) ===
# Enable market making strategy
MM_ENABLED=true

# Quote size per side in USDC
MM_QUOTE_SIZE=5.0

# Maximum spread to quote (0.04 = 4%)
MM_MAX_SPREAD=0.04

# Minimum spread to maintain profitability
MM_MIN_SPREAD=0.01

# Maximum position per market in USDC
MM_MAX_POSITION_PER_MARKET=25.0

# Inventory skew factor (0.0 = no skew, 1.0 = full skew)
MM_INVENTORY_SKEW_FACTOR=0.5

# Cooldown after volatility spike (seconds)
MM_VOLATILITY_COOLDOWN_SECONDS=30

# Maximum markets to make simultaneously
MM_MAX_MARKETS=5

# Quote refresh interval (seconds)
MM_QUOTE_REFRESH_SECONDS=5.0

# === REWARDS SETTINGS ===
# Enable rewards-aware market making
REWARDS_ENABLED=true

# Minimum reward rate to participate (0 = any reward)
REWARDS_MIN_REWARD_RATE=0.0

# Prioritize reward-eligible markets
REWARDS_PREFER_REWARD_MARKETS=true

# Quote inside max_incentive_spread by this buffer
REWARDS_MAX_INCENTIVE_SPREAD_BUFFER=0.005

# === RATE LIMITING ===
# Maximum orders per second
RATE_MAX_ORDERS_PER_SECOND=10

# Maximum API requests per second
RATE_MAX_REQUESTS_PER_SECOND=50

# Burst limit for rate limiter
RATE_BURST_LIMIT=20

# Base backoff time for rate limit errors
RATE_BACKOFF_BASE_SECONDS=1.0

# Maximum backoff time
RATE_BACKOFF_MAX_SECONDS=60.0

# === OPERATIONAL SETTINGS ===
# REST API polling interval in seconds
POLL_INTERVAL=2

# Enable WebSocket for real-time data (true/false)
USE_WEBSOCKET=true

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# SQLite database path
DATABASE_PATH=./data/trading.db

# === NOTIFICATIONS (OPTIONAL) ===
# Telegram bot token (get from @BotFather)
TELEGRAM_BOT_TOKEN=

# Your Telegram chat ID (get from @userinfobot)
TELEGRAM_CHAT_ID=

# Discord webhook URL (from channel settings)
DISCORD_WEBHOOK_URL=

# === ADVANCED SETTINGS ===
# Maximum concurrent orders
MAX_CONCURRENT_ORDERS=5

# Order timeout in seconds
ORDER_TIMEOUT=30

# Enable paper trading mode (no real orders)
PAPER_TRADING=false

# Backtest mode
BACKTEST_MODE=false

# === EXTERNAL DATA SOURCES (OPTIONAL) ===
# CoinGecko API (free tier, no key needed)
# For crypto price data used in prediction strategy

# Alternative: CryptoCompare API key
CRYPTOCOMPARE_API_KEY=

# === DEVELOPMENT ===
# Enable debug mode
DEBUG=false

# Test mode (use smaller amounts)
TEST_MODE=false
